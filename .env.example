# next-app（社内システム）と同じ DB。DB 名は postgres
DATABASE_URL=
NEXT_PUBLIC_APP_URL=

# ログイン状態（Cookie）の署名用。推測されにくい長い文字列にする
JWT_SECRET=

# AWS（Cognito を呼び出す IAM ユーザー。Amplify は AWS_ で始まる名前を設定できないため AWS_ を付けない）
REGION=ap-northeast-1
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=

# Cognito ユーザープール（ログイン・登録・パスワードリセット）
# IAM に cognito-idp:AdminInitiateAuth / AdminGetUser / AdminCreateUser / AdminSetUserPassword / AdminDeleteUser が必要
# アプリクライアントは ALLOW_ADMIN_USER_PASSWORD_AUTH を有効に、クライアントシークレットは「なし」にする
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# 応募通知メール（Amazon SES の SMTP。未設定のあいだは応募は保存されるがメールは送られない）
SES_SMTP_HOST=email-smtp.ap-northeast-1.amazonaws.com
SES_SMTP_USER=
SES_SMTP_PASS=
# 送信元（SES で検証済みのドメインのアドレス。省略時は noreply@tribe-group.jp）
MAIL_FROM=
# 応募通知の宛先（省略時は recruit_hr@emorislink.co.jp）
APPLICATION_NOTIFY_TO=

# ログイン画面の「LINE でログイン」ボタン（LINE Developers > 社内案件通知BOT > LINE ログインチャネル「スタッフ連携」）
# チャネルの「コールバックURL」に <サイトの URL>/api/auth/line/callback/ を登録してから設定する（未設定ならボタンを出さない）
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# 公式LINE（LIFF）から開いたときの自動ログイン。LINE 側を設定したら同じ値を入れる（未設定なら無効）
LIFF_ID=
NEXT_PUBLIC_LIFF_ID=

# スタッフ登録後の「LINE 友だち追加」リンク（line-recruit-hub のトラッキングリンク。末尾に ?externalRef=スタッフID が付く）
# 未設定なら next-app と同じリンク（https://line-recruit-hub.vercel.app/track/27dc72af）を使う。
# ホームページからの登録を別の流入経路として集計したいときは、line-recruit-hub で新しいリンクを作って設定する
LINE_FRIEND_TRACK_URL=
